+    "AIDLC_PROJECT_DIR=other; aidlc engine orchestrate report --result done",
+    "$env:AIDLC_PROJECT_DIR='other'; aidlc engine orchestrate report --result done",
+    "cd $OTHER; aidlc engine orchestrate report --result done",
