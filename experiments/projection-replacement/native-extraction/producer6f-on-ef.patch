+test.each(["", "a\0b", "\\absolute", "folder\\file", "/absolute", "//server/share", "C:relative", "C:/absolute", "z:", "a//b", "./a", "a/./b", "a/../b", "a/", "../a", ".", ".."])("unsafe relative metadata is refused: %s", (path) => {
