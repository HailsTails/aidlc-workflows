    "derivation": [
      "ToolName.is_default_namespace treats absent, empty and functions as default.",
      "function_hook_tool_name canonicalizes default and multi_agent_v1 spawn_agent to spawn_agent with Agent matcher alias.",
      "Other function names cross flat_tool_name, which appends namespace then name with no delimiter.",
      "hook_runtime copies HookToolName.name into PreToolUseRequest; command_input_json copies request.tool_name unchanged."
    ],
    "empiricalLimit": "A native V2 Responses event exposed namespace collaboration/name spawn_agent. No V2 command-hook stdin capture, exact source-to-binary build attestation or live UI comparison is available."
  },
  "nativeFunctionCases": [
