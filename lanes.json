{
  "schemaVersion": 2,
  "contextMap": "lint/context-map.ts",
  "glossary": "src/glossary.json",
  "hotFiles": [
    "core/tools/aidlc-lib.ts",
    "core/tools/aidlc-orchestrate.ts",
    "core/tools/aidlc-init.ts",
    "scripts/package.ts",
    "package.json",
    "bun.lock",
    "tsconfig.json",
    "eslint.config.ts",
    "harness/*/manifest.ts"
  ],
  "hotFileRule": "A lane edits a hot file only to delete the declarations listed under its monolithDeletions, or within the JSON key paths its hotFileGrants lists for that file (\"*\" grants the whole file). A lane whose owns lists a hot file's exact path writes that file freely. Any other hot-file edit goes through the integration lane.",
  "ownershipRule": "A lane owns its owns globs plus every legacy file LEGACY_TERRITORY in lint/context-map.ts assigns to a context in its territory. contractFiles are the exception: only lane 0 writes them.",
  "callerMoveGrant": "A lane that deletes a declaration from a legacy file may edit any file outside src/ only to repoint imports and call sites of that declaration to its new owner, in the same slice as the deletion.",
  "contractRule": "Lane 0 owns only what crosses an arrow: the published domain types and boundary ports in contractFiles. Each lane owns the rest of its context, including its own application layer and adapters. A lane that needs a cross-arrow change asks lane 0 for it, naming the design move it needs.",
  "lanes": {
    "0": {
      "name": "Contracts",
      "agent": "claude",
      "owns": [
        "src/glossary.json",
        "src/tsconfig.json",
        "tsconfig.strict.json",
        "src/README.md",
        "src/kernel/**",
        "src/*/fixtures/**",
        "lint/context-map.ts",
        "lint/context-map.test.ts",
        "lanes.json",
        "src/workflow-definition/domain/{identities,vocabulary,stage,agent,scope,rule,sensor,knowledge,contribution,findings,hooks,method-source,outline,method,stage-graph,refusals}{,.test}.ts",
        "src/workflow-definition/application/use-cases{,.test}.ts",
        "src/projection/domain/{projected-file,neutral-surface,host-surface,projection,template-token}{,.test}.ts",
        "src/projection/application/ports{,.test}.ts",
        "src/packaging/domain/{payload,root-integration,managed-directory,release-history}{,.test}.ts",
        "src/packaging/application/boundary-ports{,.test}.ts",
        "src/installation/domain/refusals{,.test}.ts",
        "src/installation/application/boundary-ports{,.test}.ts",
        "src/execution/domain/{identities,unit,gate,guard,host-event,refusals}{,.test}.ts",
        "src/execution/application/boundary-ports{,.test}.ts",
        "src/cli/roots{,.test}.ts"
      ],
      "contractFiles": [
        "src/workflow-definition/domain/{identities,vocabulary,stage,agent,scope,rule,sensor,knowledge,contribution,findings,hooks,method-source,outline,method,stage-graph,refusals}.ts",
        "src/workflow-definition/application/use-cases.ts",
        "src/projection/domain/{projected-file,neutral-surface,host-surface,projection,template-token}.ts",
        "src/projection/application/ports.ts",
        "src/packaging/domain/{payload,root-integration,managed-directory,release-history}.ts",
        "src/packaging/application/boundary-ports.ts",
        "src/installation/domain/refusals.ts",
        "src/installation/application/boundary-ports.ts",
        "src/execution/domain/{identities,unit,gate,guard,host-event,refusals}.ts",
        "src/execution/application/boundary-ports.ts",
        "src/cli/roots.ts"
      ],
      "territory": [],
      "monolithDeletions": {
        "src/cli/application/ports.ts": ["*"]
      }
    },
    "G": {
      "name": "Guardrails",
      "agent": "claude",
      "owns": [
        "eslint.config.ts",
        "lint/**",
        "tests/golden/**",
        "tests/ratchets/**",
        "tests/fixtures/aidlc-lib-declarations.txt",
        "tests/unit/t-aidlc-lib-only-shrinks.test.ts",
        "scripts/gate.ts",
        "biome.json",
        "disciplines.json",
        "discipline-exceptions.json",
        "disciplines.eslint.mjs",
        "disciplines.eslint.d.mts",
        "eslint.config.test.ts"
      ],
      "notOwned": ["lint/context-map.ts", "lint/context-map.test.ts"],
      "territory": [],
      "hotFileGrants": {
        "package.json": ["devDependencies", "scripts.lint", "scripts.gate"],
        "bun.lock": ["*"]
      },
      "monolithDeletions": {}
    },
    "integration": {
      "name": "Integration: Workflow Definition, Projection, Packaging + Installation",
      "agent": "codex",
      "owns": [
        "src/workflow-definition/**",
        "src/cli/adapters/routes/workflow-definition/**",
        "src/projection/**",
        "src/hosts/claude/projection/**",
        "src/hosts/claude/build.ts",
        "src/cli/adapters/routes/projection/**",
        "harness/*/**",
        "src/packaging/**",
        "src/installation/**",
        "src/hosts/{claude,codex,opencode}/{packaging,installation}/**",
        "src/cli/adapters/routes/{packaging,installation}/**",
        "src/cli/core-build-root{,.test}.ts",
        "docs/reference/15-stage-definition.md",
        "scripts/package.ts",
        "scripts/manifest-types.ts",
        "harness/claude/manifest.ts",
        "tests/unit/t64.test.ts",
        "tests/unit/t-package-sources.test.ts",
        "discipline-exceptions.json"
      ],
      "notOwned": [
        "harness/copilot/emit.ts",
        "harness/{kiro,kiro-ide,cursor}/manifest.ts",
        "harness/{codex,opencode}/{manifest,emit}.ts"
      ],
      "territory": ["workflow-definition", "projection", "packaging", "installation"],
      "consumes": ["src/kernel/**"],
      "monolithDeletions": {
        "core/tools/aidlc-lib.ts": [
          "StageEntry",
          "ScopeDefinition",
          "ScopeMetadata",
          "AgentMetadata",
          "PHASES",
          "Phase",
          "PHASE_NUMBERS",
          "loadStageGraph",
          "loadStageGraphAll",
          "loadScopeMetadataAll",
          "loadScopeMetadata",
          "loadScopeMapping",
          "loadAgents",
          "parseStageFrontmatter",
          "parseAgentFrontmatter",
          "agentsDir",
          "scopesDir",
          "isScopeName",
          "SCOPE_NAME_RULE",
          "validScopes",
          "REVIEW_CLASSES",
          "ReviewClass",
          "asReviewClass",
          "CEREMONY_KEYS",
          "CEREMONY_SETTINGS",
          "CeremonyKey",
          "CeremonySetting",
          "CeremonyPolicy",
          "GuardPolicy",
          "PER_UNIT_FOR_EACH",
          "KNOWN_PER_UNIT_STAGES",
          "isPerUnitStage"
        ],
        "core/tools/aidlc-stage-schema.ts": ["*"],
        "core/tools/aidlc-rule-schema.ts": ["*"],
        "core/tools/aidlc-sensor-schema.ts": ["*"],
        "core/tools/aidlc-graph.ts": [
          "Consume",
          "RuleResolution",
          "SensorResolution",
          "GraphStage",
          "ScopeGrid",
          "RuleFile",
          "SensorFile"
        ],
        "scripts/package.ts": ["writeHarnessData", "buildTree", "loadManifest", "writeHarness"],
        "scripts/manifest-types.ts": ["*"],
        "scripts/onboarding.ts": ["*"],
        "scripts/harness-bindings.ts": ["*"],
        "harness/copilot/manifest.ts": ["*"],
        "core/tools/aidlc-tiers.ts": ["TierProjection", "TIER_PROJECTIONS", "Harness"],
        "core/tools/aidlc-runner-gen.ts": ["*"],
        "core/tools/aidlc-init.ts": ["RootContribution", "Baseline", "PreparedRefreshSource", "PlannedAction"],
        "core/tools/aidlc-distribution.ts": [
          "ProjectionStamp",
          "RootIntegration",
          "ProjectionDescriptor",
          "JsonEntriesOwnership",
          "JsonEntriesResult"
        ],
        "core/tools/aidlc-transaction.ts": ["TransactionOperation", "TransactionPlan", "TransactionOptions"],
        "core/tools/aidlc-uninstall-plan.ts": ["*"],
        "core/tools/aidlc-runtime-paths.ts": [
          "HarnessLocation",
          "ProjectHarness",
          "callingHarness",
          "inHostShell",
          "pinRuntimeHarness",
          "harnessIsAGuess"
        ],
        "scripts/package-release.ts": ["*"]
      }
    },
    "D": {
      "name": "Workflow Execution",
      "agent": "codex",
      "startsAfter": ["integration"],
      "owns": [
        "src/execution/**",
        "src/cli/**",
        "src/hosts/*/{cli,execution}/**",
        "src/hosts/*/runtime.ts",
        "core/hooks/**"
      ],
      "notOwned": ["src/cli/core-build-root{,.test}.ts"],
      "territory": ["execution", "cli"],
      "consumes": ["src/kernel/**", "src/workflow-definition/domain/**"],
      "monolithDeletions": {
        "core/tools/aidlc-lib.ts": ["CHECKBOX_REVERSE", "resolveReviewClass", "UnitCheckpoint", "GateReply", "UnitGateRhythm"],
        "core/tools/aidlc-orchestrate.ts": ["isPerUnit", "unitCovered", "unitWalkStanding"],
        "core/tools/aidlc-unit-dag.ts": ["*"],
        "core/tools/aidlc-unit-holders.ts": ["*"],
        "core/tools/aidlc-guard-fences.ts": ["*"],
        "core/tools/aidlc-construction-checkpoints.ts": ["*"],
        "core/tools/aidlc-record-core.ts": ["CheckboxState", "IntentRegistryEntry", "IntentInfo", "SessionBindingSource", "SessionBinding", "AuditShardEvent"]
      }
    },
    "dot": {
      "name": "Projection for kiro, kiro-ide, cursor and copilot (supervised, one ticket at a time)",
      "agent": "codex/dot",
      "owns": [
        "src/hosts/{kiro,kiro-ide,cursor,copilot}/**",
        "harness/copilot/emit.ts",
        "harness/kiro/manifest.ts",
        "harness/kiro-ide/manifest.ts",
        "harness/cursor/manifest.ts"
      ],
      "notOwned": ["src/hosts/*/runtime.ts", "src/hosts/*/{cli,execution}/**"],
      "consumes": ["src/kernel/**", "src/workflow-definition/domain/**", "src/projection/domain/**"],
      "monolithDeletions": {
        "harness/copilot/emit.ts": ["*"],
        "harness/{kiro,kiro-ide,cursor}/manifest.ts": ["*"]
      }
    },
    "hosts-b": {
      "name": "Projection for codex and opencode (supervised, one ticket at a time)",
      "agent": "codex/dot",
      "owns": [
        "src/hosts/{codex,opencode}/projection/**",
        "src/hosts/{codex,opencode}/build.ts",
        "harness/codex/manifest.ts",
        "harness/codex/emit.ts",
        "harness/opencode/manifest.ts",
        "harness/opencode/emit.ts"
      ],
      "consumes": ["src/kernel/**", "src/workflow-definition/domain/**", "src/projection/domain/**"],
      "monolithDeletions": {
        "harness/{codex,opencode}/{manifest,emit}.ts": ["*"]
      }
    }
  }
}
