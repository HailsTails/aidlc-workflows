+
+  test("each host's skill renderer places the orchestrator skill in-tree at its declared path", () => {
+    const orchestratorSource = "skills/aidlc/SKILL.md";
+    const projectRootJoins = [
+      'join(projectRoot, ".agents", "skills", "aidlc"',
+      'join(projectRoot, ".github", "skills", "aidlc"',
+    ];
+    for (const { name, manifest } of HARNESS_MATRIX) {
+      expect(manifest.orchestratorSkillPath.endsWith(orchestratorSource), name).toBe(true);
+      const prefix = manifest.orchestratorSkillPath.slice(0, -orchestratorSource.length);
+      const renderer = readFileSync(join(REPO_ROOT, "src", "hosts", name, "projection", "skill-renderer.ts"), "utf-8");
+      expect(renderer, name).toContain(`\`${prefix}\${source}\``);
+      expect(renderer, name).toContain("projectPath(");
+      for (const projectRootJoin of projectRootJoins) expect(renderer, name).not.toContain(projectRootJoin);
+    }
+    const packager = readFileSync(join(REPO_ROOT, "scripts", "package.ts"), "utf-8");
+    for (const projectRootJoin of projectRootJoins) expect(packager).not.toContain(projectRootJoin);
+  });
 });
