#!/bin/sh
base="${AIDLC_GATE_BASE:-origin/rebuild/foundation}"
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushing=no
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  pushing=yes
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: $local_sha is not the checked-out commit; check it out in this worktree, then push again" >&2
    exit 1
  fi
done
[ "$pushing" = no ] && exit 0
if ! changed=$(git diff --name-only --diff-filter=ACMR "$base"...HEAD); then
  echo "pre-push: could not diff against $base; run git fetch origin, then push again" >&2
  exit 1
fi
[ -z "$changed" ] && exit 0
paths=$(printf '%s\n' "$changed" | paste -sd, -)
exec bun scripts/gate.ts --scope "$paths" --only zones,records,lint,disciplines,typecheck,monolith,kernel,isolation
