{
  "version": 1,
  "id": "CD-1",
  "clauses": [
    {
      "kind": "mechanical",
      "id": "any-cast",
      "summary": "No any, ever",
      "mechanisms": [
        "audit"
      ],
      "anchor": {
        "kind": "file"
      },
      "cases": {
        "flag": [
          {
            "name": "as any assertion",
            "fileName": "parse.ts",
            "source": "export const parsed = JSON.parse(text) as any;\n",
            "expectedLines": [
              1
            ]
          },
          {
            "name": "angle-bracket any assertion",
            "fileName": "angle.ts",
            "source": "declare const candidate: unknown;\nexport const narrowed = <any>candidate;\n",
            "expectedLines": [
              2
            ]
          },
          {
            "name": "as any on a later line",
            "fileName": "later.ts",
            "source": "declare const candidate: unknown;\nconst first = 1;\nexport const narrowed = candidate as any;\n",
            "expectedLines": [
              3
            ]
          }
        ],
        "allow": [
          {
            "name": "as unknown assertion",
            "fileName": "unknown.ts",
            "source": "export const parsed = JSON.parse(text) as unknown;\n",
            "expectedLines": []
          },
          {
            "name": "const assertion",
            "fileName": "const-assertion.ts",
            "source": "export const PERMITTED_LITERAL = \"permitted\" as const;\n",
            "expectedLines": []
          },
          {
            "name": "bare any annotation is left to review",
            "fileName": "annotation.ts",
            "source": "declare const candidate: unknown;\nexport const direct: any = candidate;\n",
            "expectedLines": []
          }
        ]
      }
    },
    {
      "kind": "mechanical",
      "id": "explicit-any",
      "summary": "No any, ever",
      "mechanisms": [
        "eslint"
      ],
      "anchor": {
        "kind": "keyword",
        "keyword": "any"
      },
      "cases": {
        "flag": [
          {
            "name": "any return annotation",
            "fileName": "src/parse.ts",
            "source": "export const parse = (text: string): any => JSON.parse(text);\n",
            "expectedLines": [
              1
            ]
          },
          {
            "name": "any type argument",
            "fileName": "src/table.ts",
            "source": "export const table = new Map<string, any>();\n",
            "expectedLines": [
              1
            ]
          },
          {
            "name": "as any cast",
            "fileName": "src/value.ts",
            "source": "export const value = JSON.parse(\"1\") as any;\n",
            "expectedLines": [
              1
            ]
          }
        ],
        "allow": [
          {
            "name": "unknown return annotation",
            "fileName": "src/parse.ts",
            "source": "export const parse = (text: string): unknown => JSON.parse(text);\n",
            "expectedLines": []
          },
          {
            "name": "the word any in a string",
            "fileName": "src/label.ts",
            "source": "export const label = \"any\";\n",
            "expectedLines": []
          }
        ]
      }
    },
    {
      "kind": "mechanical",
      "id": "implicit-any-let",
      "summary": "No any, ever",
      "mechanisms": [
        "eslint"
      ],
      "anchor": {
        "kind": "keyword",
        "keyword": "let"
      },
      "cases": {
        "flag": [
          {
            "name": "let without a type or initialiser",
            "fileName": "src/total.ts",
            "source": "let total;\nexport { total };\n",
            "expectedLines": [
              1
            ]
          },
          {
            "name": "var without a type or initialiser",
            "fileName": "src/count.ts",
            "source": "var count;\nexport { count };\n",
            "expectedLines": [
              1
            ]
          },
          {
            "name": "one report for two untyped bindings",
            "fileName": "src/pair.ts",
            "source": "let first, second;\nexport { first, second };\n",
            "expectedLines": [
              1
            ]
          }
        ],
        "allow": [
          {
            "name": "let with an initialiser",
            "fileName": "src/total.ts",
            "source": "let total = 0;\nexport { total };\n",
            "expectedLines": []
          },
          {
            "name": "let with a type annotation",
            "fileName": "src/total.ts",
            "source": "let total: number;\nexport { total };\n",
            "expectedLines": []
          },
          {
            "name": "for-of head",
            "fileName": "src/each.ts",
            "source": "export const each = (items: readonly number[]): void => {\n  for (let item of items) {\n    void item;\n  }\n};\n",
            "expectedLines": []
          },
          {
            "name": "declaration file",
            "fileName": "src/env.d.ts",
            "source": "declare let flag;\n",
            "expectedLines": []
          }
        ]
      }
    }
  ]
}
