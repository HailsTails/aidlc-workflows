{
  "version": 1,
  "id": "CD-3",
  "clauses": [
    {
      "kind": "mechanical",
      "id": "strict",
      "summary": "Strict mode flags inherited, never overridden",
      "mechanisms": [
        "walker"
      ],
      "anchor": {
        "kind": "file"
      },
      "cases": {
        "flag": [
          {
            "name": "strict set to false",
            "fileName": "packages/a/tsconfig.json",
            "source": "{\n  \"compilerOptions\": {\n    \"strict\": false\n  }\n}\n",
            "expectedLines": [
              1
            ]
          },
          {
            "name": "strict restated as true",
            "fileName": "tsconfig.json",
            "source": "{ \"compilerOptions\": { \"target\": \"ESNext\", \"strict\": true } }\n",
            "expectedLines": [
              1
            ]
          }
        ],
        "allow": [
          {
            "name": "inherits the shared base",
            "fileName": "packages/a/tsconfig.json",
            "source": "{ \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"target\": \"ESNext\" } }\n",
            "expectedLines": []
          },
          {
            "name": "only other options set",
            "fileName": "packages/b/tsconfig.json",
            "source": "{ \"compilerOptions\": { \"outDir\": \"dist\", \"target\": \"ESNext\" } }\n",
            "expectedLines": []
          },
          {
            "name": "tsconfig.base.json is not read",
            "fileName": "tsconfig.base.json",
            "source": "{ \"compilerOptions\": { \"strict\": true } }\n",
            "expectedLines": []
          }
        ]
      }
    },
