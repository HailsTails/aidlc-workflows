{
  "version": 1,
  "discipline": "CD-6",
  "mechanism": "eslint",
  "clauses": [
    {
      "clause": "naming-convention",
      "settings": {
        "pluginNamespace": "discipline-cd6",
        "pluginModule": "cd6/cd6.eslint-plugin.ts",
        "rule": "naming-convention",
        "options": [
          {
            "selector": [
              "objectLiteralProperty",
              "objectLiteralMethod",
              "typeProperty",
              "typeMethod",
              "classProperty",
              "classMethod",
              "accessor",
              "enumMember"
            ],
            "modifiers": [
              "requiresQuotes"
            ],
            "format": null
          },
          {
            "selector": [
              "variable",
              "function",
              "parameter"
            ],
            "modifiers": [
              "unused"
            ],
            "format": null,
            "filter": {
              "regex": "^_",
              "match": true
            }
          },
          {
            "selector": [
              "variable",
              "parameter"
            ],
            "modifiers": [
              "destructured"
            ],
            "format": null
          },
          {
            "selector": "import",
            "format": null
          },
          {
            "selector": [
              "classProperty",
              "classMethod",
              "accessor",
              "parameterProperty"
            ],
            "modifiers": [
              "override"
            ],
            "format": null
          },
          {
            "selector": "variable",
            "modifiers": [
              "const"
            ],
            "format": null,
            "custom": {
              "regex": "^(?:[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*|[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*))$",
              "match": true
            }
          },
          {
            "selector": "variable",
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*))?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "function",
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*))?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "function",
            "modifiers": [
              "global"
            ],
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*)|[A-Z][A-Z0-9]*)?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "parameter",
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*))?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "typeLike",
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*))?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "enumMember",
            "format": null,
            "custom": {
              "regex": "^(?:[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)$",
              "match": true
            }
          },
          {
            "selector": [
              "classProperty",
              "classMethod",
              "accessor",
              "parameterProperty"
            ],
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*)?[_$]*$",
              "match": true
            }
          },
          {
            "selector": [
              "classProperty",
              "accessor"
            ],
            "modifiers": [
              "static"
            ],
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "objectLiteralProperty",
            "format": null,
            "custom": {
              "regex": "^(?:[a-z0-9][A-Za-z0-9]*)$",
              "match": true
            }
          },
          {
            "selector": "objectLiteralMethod",
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*)?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "typeProperty",
            "format": null,
            "custom": {
              "regex": "^(?:[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*))$",
              "match": true
            }
          },
          {
            "selector": "typeMethod",
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*)?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "import",
            "modifiers": [
              "default"
            ],
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*)|[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)?[_$]*$",
              "match": true
            }
          },
          {
            "selector": "import",
            "modifiers": [
              "namespace"
            ],
            "format": null,
            "custom": {
              "regex": "^[_$]*(?:[a-z0-9][A-Za-z0-9]*|[A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*|[0-9]*))?[_$]*$",
              "match": true
            }
          }
        ]
      }
    }
  ]
}
