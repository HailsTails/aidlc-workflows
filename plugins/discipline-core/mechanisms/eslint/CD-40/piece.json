{
  "version": 1,
  "discipline": "CD-40",
  "mechanism": "eslint",
  "clauses": [
    {
      "clause": "parameter-count",
      "settings": {
        "pluginNamespace": "discipline-cd40",
        "pluginModule": "cd40/cd40.eslint-plugin.ts",
        "rule": "max-params",
        "options": [
          {
            "max": 2,
            "countVoidThis": true
          }
        ]
      }
    }
  ]
}
