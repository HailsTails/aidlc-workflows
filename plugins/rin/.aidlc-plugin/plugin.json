{
  "name": "rin",
  "version": "0.1.0",
  "description": "Rin's gated delivery pipeline, driven one Slice at a time against a consumer-selected backlog, with decorrelated multi-lens review at the locking and review gates.",
  "author": {
    "name": "HailsTails"
  },
  "dependencies": ["core"],
  "aidlc": {
    "tokens": {
      "{{OPERATOR}}": "the operator",
      "{{AUTHOR_IDENTITY}}": "the authoring identity",
      "{{REVIEWER_IDENTITY}}": "the reviewing identity",
      "{{DEPLOY_TARGET}}": "the deployment target",
      "{{BACKLOG_STORE}}": "the backlog store",
      "{{MERGE_COMMAND}}": "(unconfigured: set projectIdentity.mergeCommand to a command that refuses a merge whose latest review verdict is not APPROVED)",
      "{{REVIEW_COMMAND}}": "(unconfigured: set projectIdentity.reviewCommand to a command that posts a review verdict under an identity distinct from the authoring identity)",
      "{{PR_COMMAND}}": "(unconfigured: set projectIdentity.prCommand to a command that opens or updates the pull request for the current branch under the authoring identity)",
      "{{DEPLOY_COMMAND}}": "(unconfigured: set projectIdentity.deployCommand to a command that deploys the target, total and idempotent)",
      "{{WORKTREE_TOOL}}": "creating an agent worktree with git worktree add",
      "harness": {
        "claude": {
          "{{WORKTREE_TOOL}}": "the EnterWorktree tool"
        },
        "codex": {
          "{{WORKTREE_TOOL}}": "creating an agent worktree with git worktree add"
        },
        "opencode": {
          "{{WORKTREE_TOOL}}": "an operator move (session guide) or creating an agent worktree with git worktree add"
        }
      }
    },
