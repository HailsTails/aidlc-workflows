{
  "exclude": [
    ".github",
    "core",
    "harness",
    "lint/gate",
    "plugins",
    "scripts/agent-knowledge.ts",
    "scripts/build-binaries.ts",
    "scripts/ci-changelog-guard.ts",
    "scripts/ci-credential-broker.ts",
    "scripts/ci-full-suite-evidence.ts",
    "scripts/ci-full-suite-result.ts",
    "scripts/ci-live-filter.ts",
    "scripts/ci-live-sandbox.ts",
    "scripts/ci-macos-unit-selection.ts",
    "scripts/ci-preview-test-report.ts",
    "scripts/ci-retry-report.ts",
    "scripts/ci-sanitize-logs.ts",
    "scripts/ci-start-credential-broker.ts",
    "scripts/ci-test-weights.ts",
    "scripts/ci-update-from-previous.ts",
    "scripts/copy-era-files.ts",
    "scripts/docs-rewrite-links.ts",
    "scripts/gate.ts",
    "scripts/package-release.ts",
    "scripts/plan-preview-release.ts",
    "scripts/plugin-hooks-template",
    "scripts/preview-release.ts",
    "scripts/publish-release.ts",
    "scripts/release-notes.ts",
    "scripts/release-promotion.ts",
    "scripts/trace-audit-judge.ts",
    "scripts/trace-audit.ts",
    "scripts/verify-release.ts",
    "tests",
    "tsconfig.json"
  ],
  "version": 1,
  "ruleSets": {},
  "clauses": {
    "CD-1#any-cast": "audit",
    "CD-1#explicit-any": "eslint",
    "CD-1#implicit-any-let": "eslint",
    "CD-2#cast-expressions": "audit",
    "CD-3#strict": "audit",
    "CD-3#no-unchecked-indexed-access": "audit",
    "CD-3#exact-optional-property-types": "audit",
    "CD-3#no-implicit-override": "audit",
    "CD-3#no-fallthrough-cases-in-switch": "audit",
    "CD-3#no-property-access-from-index-signature": "audit",
    "CD-3#use-unknown-in-catch-variables": "audit",
    "CD-5#comments-directives": "audit",
    "CD-6#identifier-names": "audit",
    "CD-6#naming-convention": "eslint",
    "CD-7#categorical-paths": "audit",
    "CD-7#filename-case": "eslint",
    "CD-7a#factory-return-types": "audit",
    "CD-8#switch-defaults": "audit",
    "CD-10#throws-in-tests": "audit",
    "CD-10#throw-only-error": "eslint",
    "CD-14#class-syntax": "audit",
    "CD-14#static-only-class": "eslint",
    "CD-15#loops": "audit",
    "CD-17#clock-sources": "audit",
    "CD-19#import-boundaries": "audit",
    "CD-23#export-test-sibling": "audit",
    "CD-25#dependency-isolation": "audit",
    "CD-26#module-mocking": "audit",
    "CD-27#test-body-logic": "audit",
    "CD-27#focused-tests": "eslint",
    "CD-27#skipped-tests": "eslint",
    "CD-40#parameter-count": "eslint",
    "CD-41#cognitive-complexity": "eslint",
    "CD-41#function-length": "eslint",
    "CD-42#useless-else": "eslint",
    "CD-43#boolean-signatures": "audit",
    "CD-44#parameter-mutation": "audit",
    "CD-44#parameter-reassignment": "eslint",
    "CD-47#hermetic-git-spawns": "audit"
  }
}
