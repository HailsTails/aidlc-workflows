{
  "version": 1,
  "ruleSets": {},
  "clauses": {
    "CD-3#strict": "audit",
    "CD-3#no-unchecked-indexed-access": "audit",
    "CD-3#exact-optional-property-types": "audit",
    "CD-3#no-implicit-override": "audit",
    "CD-3#no-fallthrough-cases-in-switch": "audit",
    "CD-3#no-property-access-from-index-signature": "audit",
    "CD-3#use-unknown-in-catch-variables": "audit",
    "CD-5#comments-directives": "audit",
    "CD-7#categorical-paths": "audit",
    "CD-7#filename-case": "not-run",
    "CD-7a#factory-return-types": "audit",
    "CD-8#switch-defaults": "audit",
    "CD-14#class-syntax": "audit",
    "CD-14#static-only-class": "not-run",
    "CD-15#loops": "audit",
    "CD-19#import-boundaries": "audit",
    "CD-27#test-body-logic": "audit",
    "CD-27#focused-tests": "not-run",
    "CD-27#skipped-tests": "not-run"
  },
  "clauseSettings": {
    "CD-3#strict": { "edition": "2" },
    "CD-3#no-unchecked-indexed-access": { "edition": "2" },
    "CD-3#exact-optional-property-types": { "edition": "2" },
    "CD-3#no-implicit-override": { "edition": "2" },
    "CD-3#no-fallthrough-cases-in-switch": { "edition": "2" },
    "CD-3#no-property-access-from-index-signature": { "edition": "2" },
    "CD-3#use-unknown-in-catch-variables": { "edition": "2" },
    "CD-5#comments-directives": { "trackerPatterns": ["^\\(spec-\\d+\\)$"] },
    "CD-19#import-boundaries": {
      "confinedPackages": [
        "eslint",
        "winston",
        "winston-transport",
        "better-sqlite3",
        "pino",
        "hono",
        "@hono/node-server",
        "jose",
        "@modelcontextprotocol/sdk",
        "zod-to-json-schema",
        "uuid"
      ]
    },
    "CD-27#test-body-logic": { "edition": "2" }
  },
  "exclude": [
    ".github",
    "assets",
    "core",
    "docs",
    "harness",
    "plugins/test-pro",
    "scripts",
    "tests",
    "vitest.rin.config.ts",
    "plugins/rin/tools/test-fixtures"
  ]
}
