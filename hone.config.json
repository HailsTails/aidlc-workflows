{
  "version": 2,
  "ruleSets": {},
  "checks": {
    "authored-class-or-this#class-keyword": "walker",
    "authored-class-or-this#static-members-only": "eslint",
    "boolean-in-a-signature#boolean-annotation": "walker",
    "branch-in-a-test#test-body": "walker",
    "claimed-type#cast-to-any": "walker",
    "claimed-type#non-null-assertions": "eslint",
    "claimed-type#unlisted-cast-site": "walker",
    "computed-value-in-a-test#test-body": "walker",
    "date-used-directly#clock-sources": "walker",
    "default-on-a-closed-union#default-arm": "walker",
    "double-with-a-body#logic-in-a-passed-function": "walker",
    "double-with-a-body#stub-implementation": "walker",
    "drawer-path#drawer-names": "walker",
    "inherited-environment-in-a-subprocess#git-spawn-environment": "walker",
    "long-function#function-length": "eslint",
    "loop-keyword#loop-statement": "walker",
    "module-or-global-patched#module-mock-call": "walker",
    "name-off-its-casing#filename-case": "eslint",
    "name-off-its-casing#naming-convention": "eslint",
    "outside-import-past-a-boundary#import-or-require": "walker",
    "positional-parameters#parameter-count": "eslint",
    "rebinding#parameter-reassignment": "eslint",
    "rebinding#test-body": "walker",
    "shorthand-name#identifier-names": "walker",
    "strictness-weakened#exact-optional-property-types": "walker",
    "strictness-weakened#no-fallthrough-cases-in-switch": "walker",
    "strictness-weakened#no-implicit-override": "walker",
    "strictness-weakened#no-property-access-from-index-signature": "walker",
    "strictness-weakened#no-unchecked-indexed-access": "walker",
    "strictness-weakened#strict": "walker",
    "strictness-weakened#use-unknown-in-catch-variables": "walker",
    "tangled-function#cognitive-complexity": "eslint",
    "test-switched-off#focused-tests": "eslint",
    "test-switched-off#skipped-tests": "eslint",
    "text-past-its-reader#test-body": "walker",
    "throw-or-catch-in-a-test#throw-statement": "walker",
    "throw-or-catch-in-a-test#try-block": "walker",
    "thrown-non-error#throw-only-error": "eslint",
    "type-derived-from-code#factory-return-types": "walker",
    "unit-without-a-running-test#companion-test-file": "walker",
    "untracked-escape#directive-pointers": "walker",
    "untyped-value#explicit-any": "eslint",
    "untyped-value#implicit-any-let": "eslint",
    "work-inside-a-condition#else-after-an-exit": "eslint",
    "write-into-a-parameter#parameter-mutation": "walker"
  },
  "exclude": [
    ".github",
    "core",
    "harness",
    "lint/gate",
    "plugins",
    "scripts/agent-knowledge.ts",
    "scripts/build-binaries.ts",
    "scripts/ci-changelog-guard.ts",
    "scripts/ci-credential-broker.ts",
    "scripts/ci-full-suite-evidence.ts",
    "scripts/ci-full-suite-result.ts",
    "scripts/ci-live-filter.ts",
    "scripts/ci-live-sandbox.ts",
    "scripts/ci-macos-unit-selection.ts",
    "scripts/ci-preview-test-report.ts",
    "scripts/ci-retry-report.ts",
    "scripts/ci-sanitize-logs.ts",
    "scripts/ci-start-credential-broker.ts",
    "scripts/ci-test-weights.ts",
    "scripts/ci-update-from-previous.ts",
    "scripts/copy-era-files.ts",
    "scripts/docs-rewrite-links.ts",
    "scripts/gate.ts",
    "scripts/package-release.ts",
    "scripts/plan-preview-release.ts",
    "scripts/plugin-hooks-template",
    "scripts/preview-release.ts",
    "scripts/publish-release.ts",
    "scripts/release-notes.ts",
    "scripts/release-promotion.ts",
    "scripts/trace-audit-judge.ts",
    "scripts/trace-audit.ts",
    "scripts/verify-release.ts",
    "tests",
    "tsconfig.json"
  ]
}
